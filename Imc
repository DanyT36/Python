from datetime import datetime

nome = input("Digite o seu nome:")
peso = float(input("Digite o seu peso:"))
alt = float(input("Digite a sua altura:"))
anonasc = int(input("Digite o ano do seu nascimento:"))
anoatual = datetime.now().year
imc = float(peso/(alt * alt))

idade = anoatual - anonasc

if (imc <= 18.5):
    print(f"{nome} de {idade} anos com imc igual a {imc} está abaixo do peso normal")
elif (imc > 18.5) or (imc <= 24.9):
    print(f"{nome} de {idade} anos com imc igual a {imc} está com peso normal")
elif (imc > 25.0) or (imc <= 29.9):
    print(f"{nome} de {idade} anos com imc igual a {imc} está com excesso de peso")
elif (imc > 30.0) or (imc <= 34.9):
    print(f"{nome} de {idade} anos com imc igual a {imc} está com obesidade classe I")
elif (imc > 35.0) or (imc <= 39.9):
    print(f"{nome} de {idade} anos com imc igual a {imc} está com obesidade classe II")
elif (imc >= 40):
     print(f"{nome} de {idade} anos com imc igual a {imc} está com obesidade classe III")

